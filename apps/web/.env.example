# The three values that turn admin sign-in on. All come from the stack's outputs and none is a
# secret; leave them unset and the Admin dialog says sign-in isn't set up in this build.

# AdminApiUrl: base URL of the admin API, no trailing slash
VITE_API_BASE_URL=
# AdminHostedUiUrl: the Cognito hosted sign-in pages
VITE_COGNITO_DOMAIN=
# AdminUserPoolClientId: the browser client
VITE_COGNITO_CLIENT_ID=

# Google Analytics. Leave it out and a `vite build` carries the site's own property ID (see
# vite.config.ts). Set it to another G- ID to report somewhere else, or to nothing, as below, to
# build without the tag at all. The dev server never has the tag either way.
VITE_GA_MEASUREMENT_ID=
