{
  "name": "cert-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "infra"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "schema:gen": "node scripts/schema-gen.ts",
    "snapshot:local": "node scripts/snapshot-local.ts",
    "e2e": "npm run e2e -w apps/web",
    "lhci": "npm run lhci -w apps/web",
    "pwa:icons": "node scripts/pwa-icons.ts",
    "og:image": "node scripts/og-image.ts",
    "dev": "npm run dev -w apps/web",
    "seed:import": "node scripts/seed-import.ts",
    "cdk": "npm run cdk -w infra --",
    "fixtures:record": "node scripts/fixtures-record.ts",
    "eval:triage": "node --import ./scripts/lib/md-hook.ts scripts/eval-triage.ts",
    "source:set": "node scripts/source-set.ts",
    "candidate:add": "node scripts/candidate-add.ts",
    "vendor:icons": "node scripts/vendor-icons.ts",
    "pr:draft": "node scripts/pr-draft.ts",
    "pr:open": "node scripts/pr-open.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
